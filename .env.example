# ==============================================================================
# EV Battery Swapping Platform - Environment Configuration
# Copy this file to .env and fill in the values
# ==============================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://evbattery_user:evbattery_pass@localhost:5432/evbattery_db?schema=public"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# --- Thermal Alarm Thresholds ---
THERMAL_RUNAWAY_THRESHOLD_CELSIUS=55
THERMAL_ALARM_DEBOUNCE_MS=3000

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
